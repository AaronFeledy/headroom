# Per-user service for an official managed Headroom installation.
# Install as ~/.config/systemd/user/headroom.service; do not use a system unit.
[Unit]
Description=Headroom usage API
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h
EnvironmentFile=-%h/.config/headroom/server.env
ExecStart=%h/.local/bin/headroom serve --config %h/.config/headroom/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
