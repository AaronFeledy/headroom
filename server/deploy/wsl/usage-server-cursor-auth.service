[Unit]
Description=Supply the WSL Cursor login to the usage API
After=usage-server.service

[Service]
Type=oneshot
User=USER
Group=USER
Environment=HOME=/home/USER
EnvironmentFile=/home/USER/.config/headroom/server.env
ExecStart=/usr/bin/python3 /home/USER/.local/lib/claude-usage-widget/sync_cursor_auth.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
